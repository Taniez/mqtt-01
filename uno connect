void setup() {
  Serial.begin(9600); // ตั้งค่าความเร็วในการรับส่งข้อมูล (Baud rate)
  pinMode(LED_BUILTIN, OUTPUT);
  pinMode(3,OUTPUT);
  pinMode(5,OUTPUT);
  pinMode(6,OUTPUT);
}

void loop() {
  if (Serial.available() > 0) {
    String data = Serial.readStringUntil('\n'); // อ่านข้อมูลที่ส่งมา
     data.trim();
    
    // เปิดไฟ LED เพื่อแสดงสถานะว่าได้รับข้อมูลแล้ว
    digitalWrite(LED_BUILTIN, HIGH);
    delay(200);
    digitalWrite(LED_BUILTIN, LOW);
    
    // ส่งข้อมูลกลับไปยัง Raspberry Pi
    Serial.println("Hello from Arduino! I received: " + data);

    if (data =="red"){
      digitalWrite(3,HIGH);
    }
        if (data =="green"){
      digitalWrite(5,HIGH);
    }
        if (data =="yellow"){
      digitalWrite(6,HIGH);
    }
      if (data =="close"){
      digitalWrite(3,LOW);
      digitalWrite(6,LOW);
      digitalWrite(5,LOW);
    }
  }
}
